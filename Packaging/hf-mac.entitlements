<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections: the Hugging Face Hub API + Spaces, and Osaurus on
	     localhost:1337. (Sandbox network.client covers loopback.) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Voice (preview): microphone for on-device dictation. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
